{
  "version": 2,
  "builds": [
    { "src": "api/aggregate.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "script.js", "use": "@vercel/static" },
    { "src": "manifest.json", "use": "@vercel/static" },
    { "src": "icon.png", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/aggregate", "dest": "/api/aggregate.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}